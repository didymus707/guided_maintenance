    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">B2BMaintenancePsuController – PSU swap (grab, drop, snap)</span>"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"group_start", "label":"References"}'
