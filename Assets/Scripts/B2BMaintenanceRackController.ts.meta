  InputLines:
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">B2BMaintenanceRackController – virtual server rack stand-in</span>"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"group_start", "label":"References"}'
    - '// @input SceneObject rackFrame {"hint":"Empty root the rack frame + filler server units are built under"}'
    - '// @input SceneObject targetChassis {"hint":"Target blade chassis root (~130 cm off the floor). PSU slots, power button and LEDs live under it"}'
    - '// @input SceneObject scanLine {"hint":"Blue diagnostics scan line; swept from the rack top to the floor"}'
    - '// @input SceneObject faultBox {"hint":"Red bounding box around PSU Slot 2"}'
    - '// @input SceneObject powerButton {"hint":"Virtual power button on the chassis (pinch to boot)"}'
    - '// @input SceneObject leds {"hint":"Row of chassis status LEDs (boot sequence)"}'
    - '// @input SceneObject stepArrow {"hint":"Pulsing 3D arrow pointing at the power button"}'
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"group_start", "label":"Settings"}'
    - '// @input vec3 rackSizeCm = "{60, 200, 100}" {"hint":"Rack width / height / depth in cm (real size)"}'
    - '// @input float scanDurationSeconds = 1 {"hint":"Duration of the blue scan sweep, seconds", "widget":"slider", "min":0.3, "max":3, "step":0.1}'
    - '// @input float bootBlinkCount = 4 {"hint":"Amber blink cycles before the LEDs settle on solid green", "widget":"slider", "min":1, "max":8, "step":1}'
    - '// @input float bootStepSeconds = 0.3 {"hint":"Seconds per amber blink half-cycle / per green LED fill step", "widget":"slider", "min":0.1, "max":1, "step":0.05}'
    - '// @input vec4 wireColor = "{0.9, 0.97, 1.0, 0.95}" {"hint":"Glowing wireframe color for the rack frame and target chassis", "widget":"color"}'
    - '// @input vec4 accentColor = "{0.35, 0.9, 1.0, 0.6}" {"hint":"Accent color for filler server units and slot outlines", "widget":"color"}'
    - '// @input vec4 scanColor = "{0.25, 0.6, 1.0, 0.95}" {"hint":"Diagnostics scan line color", "widget":"color"}'
    - '// @input vec4 faultColor = "{1.0, 0.2, 0.2, 1.0}" {"hint":"Fault bounding box color", "widget":"color"}'
    - '// @ui {"widget":"group_end"}'
