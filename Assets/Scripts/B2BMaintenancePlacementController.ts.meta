  InputLines:
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">B2BMaintenancePlacementController – ghost rack + floor anchoring</span>"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"group_start", "label":"References"}'
    - '// @input SceneObject cameraObject {"hint":"The world camera (Camera Object)"}'
    - '// @input SceneObject ghostPose {"hint":"Pose root moved to the gaze point on the floor (rack front-center at floor level)"}'
