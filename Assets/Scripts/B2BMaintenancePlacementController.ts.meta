    - '// @ui {"widget":"group_start", "label":"Settings"}'
    - '// @input float eyeHeightCm = 160 {"hint":"Fallback floor: camera height above the floor in cm (used when no real surface is found)", "widget":"slider", "min":100, "max":200, "step":1}'
